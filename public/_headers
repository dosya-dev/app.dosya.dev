# frame-ancestors is 'self', not 'none': the ebook reader runs foliate-js in a
# same-origin iframe (/reader/index.html), and 'none' blocks a page from being
# framed even by its own origin - the reader failed with "Framing
# 'https://app.dosya.dev/' violates ... frame-ancestors 'none'". 'self' still
# refuses every third-party frame, which is the clickjacking threat this
# directive exists for; it only stops the site refusing itself.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com https://docs.dosya.dev; style-src 'self' 'unsafe-inline' blob:; img-src 'self' data: blob: https://api.dosya.dev; media-src 'self' blob: data: https://api.dosya.dev; font-src 'self' blob: data:; connect-src 'self' https://api.dosya.dev https://challenges.cloudflare.com https://docs.dosya.dev; frame-src 'self' blob: https://api.dosya.dev https://challenges.cloudflare.com https://docs.dosya.dev; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Vite content-hashes everything under /assets/, so cache forever. Unhashed
# files (theme-init.js, sw.js, favicons) keep the Pages default revalidation.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
