/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://api.dosya.dev; font-src 'self'; connect-src 'self' https://api.dosya.dev https://challenges.cloudflare.com; frame-src 'self' https://api.dosya.dev https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Vite content-hashes everything under /assets/, so cache forever. Unhashed
# files (theme-init.js, sw.js, favicons) keep the Pages default revalidation.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
